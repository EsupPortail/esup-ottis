# =============================================================================
# Configuration OTTIS - Fichier d'environnement
# =============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement
# Ne commitez JAMAIS le fichier .env dans le dépôt Git
#
# IMPORTANT : toute la configuration de la traduction (choix du traducteur,
# tokens DeepL/Google, serveur LibreTranslate) se fait dans tables/tokens.json
# (copiez tables/tokens.json.example). Ce fichier ne porte que l'infrastructure.
# =============================================================================

# Environnement (development, staging, production)
APP_ENV=development

# Authentification CAS : true/false
# Désactivé par défaut. Voir config/cas.php pour la configuration du serveur CAS.
CAS_ENABLED=false

# Serveur CAS - OPTIONNEL : surcharge les valeurs par défaut de config/cas.php
# (Nantes Université). Absent, vide ou invalide : valeur par défaut conservée.
#CAS_HOST=cas.mon-etablissement.fr
#CAS_PORT=443
#CAS_URL=/cas/

# Proxy (laisser vide si aucun)
HTTP_PROXY=

# =============================================================================
# Paramétrage client (affiché dans la navigation)
# =============================================================================

# Mail de contact (lien "Contact") - exemple, a remplacer par client,
# sinon l'entree est masquee de la navigation
CONTACT_EMAIL=support@univ.fr

# Lien externe "Aide" - exemple, a remplacer par client,
# sinon l'entree est masquee de la navigation
HELP_URL=https://support.univ.fr

# =============================================================================
# Mesure d'audience (Matomo)
# =============================================================================

# URL complete du tracker Matomo du client (se termine par /matomo.php).
# Laisser vide ou absent : Matomo DESACTIVE (aucun script emis, aucune collecte).
MATOMO_URL=

# Identifiant du site declare dans l'instance Matomo du client (nombre)
MATOMO_SITE_ID=
