# =============================================================================
# Configuration OMIST - Fichier d'environnement
# =============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement
# Ne commitez JAMAIS le fichier .env dans le dépôt Git
#
# IMPORTANT : les tokens API de traduction (DeepL, Google) ne sont PAS dans ce
# fichier. Ils se configurent dans tables/tokens.json
# (copiez tables/tokens.json.example).
# =============================================================================

# Environnement (development, staging, production)
APP_ENV=development

# Authentification CAS : true/false
# Désactivé par défaut. Voir config/cas.php pour la configuration du serveur CAS.
CAS_ENABLED=false

# Serveur LibreTranslate (optionnel - défaut : https://translate.terraprint.co/translate)
LIBRETRANSLATESERVER=

# Proxy (laisser vide si aucun)
HTTP_PROXY=
