includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 5
    paths:
        - src
        - Security
        - config
        - includes
        - *.php
    excludePaths:
        analyse:
            - vendor/*
            - node_modules/*
            - tmp/*
            - uploads/*
            - Security/tmp/*
            - Security/legacy_functions.php
            - Security/sanitize.php
            - Security/csrf.php
            - Security/validate.php
            - Security/room_tokens.php
            - Security/validate_room_token.php
            - Security/init.php
            - Security/load_env.php
    checkMissingIterableValueType: false
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false
    allowDynamicProperties: false
    checkExtraArguments: true
    checkFunctionNameCase: true
    checkMethodNameCase: true
    checkPropertyNameCase: true
