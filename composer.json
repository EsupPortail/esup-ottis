{
    "require": {
        "php": "^8.2",
        "phpoffice/phppresentation": "^1.2",
        "phpoffice/common": "^1.1",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.5",
        "apereo/phpcas": "^1.6.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.13",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "files": [
            "Security/validate.php",
            "Security/sanitize.php",
            "Security/room_tokens.php",
            "Security/validate_room_token.php",
            "Security/load_env.php",
            "Security/logger.php"
        ],
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.34"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
