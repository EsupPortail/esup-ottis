{
    "require": {
        "php": "^8.4",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.5",
        "apereo/phpcas": "^1.6.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.13",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.28"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "license":("GPL-2.0-or-later")
}
