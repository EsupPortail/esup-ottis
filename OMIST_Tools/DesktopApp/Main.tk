# OMIST Main file
wm title . "OMIST Translation Tools"
wm geometry . 590x240+100+100

# Widget creation

image create photo imgobj -file "logo-next-omist.png" -width 75 -height 35
label .labeltitre -text "NExT OMIST : Slides manipulation Tools" -font {helvetica -20 bold}
label .labeltitreimg -image imgobj
label .labelwhite -text " " -font {helvetica -20 bold} -width 1

button .app1 -text "Automatic Slides Translation" -command {exec wish ./TranslateSlides.tk &} -width 50 -font {helvetica -18 bold}
button .app2 -text "Multilingual animation creation (from PPTX) (mac only)" -command {exec wish ./CreateApp.tk &} -width 50 -font {helvetica -18 bold}
button .app2bis -text "Multilingual animation creation (from PPTX) (universal)" -command {exec wish ./CreateApp_universal.tk &} -width 50 -font {helvetica -18 bold}
button .app3 -text "Multilingual animation creation (from PDF + TXT)" -command {exec wish ./CreateAppPDF.tk &} -width 50 -font {helvetica -18 bold}
button .app4 -text "(PDF + TXT) to PPT conversion" -command {exec wish ./ConvertPDF.tk &} -width 50 -font {helvetica -18 bold}
button .app5 -text "PPTX speech extraction (to TXT)" -command {exec wish ./SpeechExtraction.tk &} -width 50 -font {helvetica -18 bold}
button .quit -text "Quit" -command {exit 0} -width 50 -font {helvetica -18 bold}

grid .labelwhite -row 0 -column 0
grid .labeltitre -row 0 -column 1
grid .labeltitreimg  -row 0 -column 2
grid .app1  -row 1 -column 1 -columnspan 2
grid .app2  -row 2 -column 1 -columnspan 2
grid .app2bis  -row 3 -column 1 -columnspan 2
grid .app3  -row 4 -column 1 -columnspan 2
grid .app4  -row 5 -column 1 -columnspan 2
grid .app5  -row 6 -column 1 -columnspan 2
grid .quit  -row 7 -column 1 -columnspan 2

proc resize {} {
  wm geometry . [expr [winfo reqwidth .]+20]x[expr [winfo reqheight .]+20]+100+100
}

after 500 resize
