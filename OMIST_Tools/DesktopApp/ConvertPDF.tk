#!/bin/sh
#exec wish "$0" "$1" & exit 0


wm title . "OMIST Tools : PDF+TXT to PPT"
wm geometry . 570x220+100+100


# Global variables

set filename ""

# Functions and procedures


proc convertToPPT {} {
    global filename
    global filenamespeech
    global combovalue
    if {$filename eq ""} {
      tk_dialog .myDialog "File missing" "Presentation file is missing" questhead 0 "OK"
      return
    }
    set filespeech $filenamespeech
    if {$filenamespeech eq ""} {
      set filespeech "blank.txt"
    }
    set V_aspectratio [string cat "--AspectRatio=" $combovalue]
    # things are different for pdf and pptx
    if {[file extension $filename] eq "pptx"} {
      if {[llength $Translate]>0} {
        exec ./GetImagesFromPPTX_with_translation.sh "$filename" "$From" "$To" "$Translate" "$K_aspectratio" "$V_aspectratio"
      } else {
        exec ./GetImagesFromPPTX.sh "$filename" "$From" "$To" "$K_aspectratio" "$V_aspectratio"
      }
    } else {
      exec open tmp
      exec ./Convert_PDF_to_PPT.sh "$filename" "$filespeech" "$V_aspectratio"
    }
}


# Widget creation

label .labelwhite -text " " -font {helvetica -20 bold} -width 1

image create photo imgobj -file "logo-next-omist.png" -width 75 -height 35
label .labeltitre -text "NExT OMIST : PDF+TXT to PPT conversion Tool" -font {helvetica -18 bold}
label .labeltitreimg -image imgobj

label .lf -text "Choose your (.pdf) file for slides"
entry .filename -textvariable filename

set typesSlides {
    {{pdf Files}       {.pdf}        }
}

set typesSpeech {
    {{txt Files}       {.txt}        }
}

button .b1 -text "Browse" -command {set filename [tk_getOpenFile -filetypes $typesSlides]}

label .lfs -text "Choose your (.txt) file for speech"
entry .filenamespeech -textvariable filenamespeech
button .b2 -text "Browse" -command {set filenamespeech [tk_getOpenFile -filetypes $typesSpeech]}


button .bcreate -text "Convert" -command "convertToPPT" -font {"Helvetica" -18 bold} -width 15

label .advancedoptions -text "Advanced options" -justify left -font {"Helvetica" -14 bold}
label .laspectratio -text "Aspect ratio" -justify left  -font {"Helvetica" -14 italic}
ttk::combobox .s1  -textvariable combovalue -values {"16/10" "16/9" "4/3"} -width 10 -justify left -state normal
button .quit -text "Quit" -command {exit 0} -width 15 -font {helvetica -18 bold}

# Initializations

set combovalue "16/10"


# Bindings

# Widget placement layout

grid .labelwhite -row 0 -column 0

grid .labeltitre -row 0 -column 1 -columnspan 3
grid .labeltitreimg -row 0 -column 4

grid .lf -row 4 -column 1
grid .filename -row 4 -column 2
grid .b1 -row 4 -column 3

grid .lfs -row 5 -column 1
grid .filenamespeech -row 5 -column 2
grid .b2 -row 5 -column 3


grid .bcreate -row 15 -column 4
grid .quit -row 16 -column 4

grid .advancedoptions -row 7 -column 1

grid .laspectratio -row 11 -column 1
grid .s1 -row 12 -column 1 -sticky news -columnspan 2

proc resize {} {
  wm geometry . [expr [winfo reqwidth .]+20]x[expr [winfo reqheight .]+20]+100+100
}

after 500 resize
