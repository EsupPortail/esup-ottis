/**
 * @summary Wait for the SpeechSynthesis Voices to be available 
 * 
 */

function loadVoicesWhenAvailable() {
    Tvoices = window.speechSynthesis.getVoices();

    if (Tvoices.length !== 0) {
        LoadVoices();
    } else {
        setTimeout(function() {
            loadVoicesWhenAvailable();
        }, 10)
    }
}

/**
 * @summary Load the voices 
 * 
 */

function LoadVoices() {
    InitVoices();
    Lancer();
}


