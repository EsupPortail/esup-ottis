function PopulateVoicesIn() {
    let select = _('VoiceInput');
    let select2 = _('classroomlanguage');
    let voices = window.speechSynthesis.getVoices();
    //alert(voices[0].name);
    TLangInput = [];
    for (let i = 0; i < voices.length; i++) {
        if (voices[i].localService) {
