{
  "name": "omist-automatic-translator",
  "version": "3.2.0",
  "description": "OMIST Automatic Translator",
  "private": true,
  "scripts": {
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "format": "prettier --write \"js/**/*.js\"",
    "format:check": "prettier --check \"js/**/*.js\"",
    "lint-and-format": "npm run lint && npm run format",
    "check": "npm run lint:fix && npm run format:check",
    "test": "./vendor/bin/phpunit && ./scripts/test-js.sh",
    "test:php": "LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6 ./vendor/bin/phpunit",
    "test:js": "./scripts/test-js.sh",
    "test:js:watch": "cd js && LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/bin/node ./node_modules/.bin/vitest",
    "test:js:coverage": "./scripts/test-js-coverage.sh"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-security": "^1.7.0",
    "eslint-plugin-no-secrets": "^0.8.9",
    "prettier": "^3.0.3"
  },
  "eslintConfig": {
    "extends": "./.eslintrc.json"
  }
}
