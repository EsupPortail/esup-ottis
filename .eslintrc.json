{
  "env": {
    "browser": true,
    "es2021": true,
    "node": false
  },
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "vars": "local", "args": "none" }],
    "no-console": "off",
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "semi": ["warn", "always"]
  }
}
